{
  "note": "Shared inputs for the native rules (test/contract-fixtures.test.cjs) and the browser preview (ui/test/mock-contract.test.cjs). `native` and `mock` name the expected outcome; a different value on the same case is a confirmed, documented difference to fix separately.",
  "settings": [
    {"name": "onboarding milestones are independent", "patch": {"onboardingStarted": true, "onboardingDemoSeen": true, "onboardingCompleted": false}, "native": "accepts", "mock": "accepts"},
    {"name": "onboarding microphone choice", "patch": {"onboardingAudioSource": "microphone"}, "native": "accepts", "mock": "accepts"},
    {"name": "onboarding computer choice", "patch": {"onboardingAudioSource": "computer"}, "native": "accepts", "mock": "accepts"},
    {"name": "onboarding unchosen source", "patch": {"onboardingAudioSource": ""}, "native": "accepts", "mock": "accepts"},
    {"name": "onboarding rejects unsupported source", "patch": {"onboardingAudioSource": "browser"}, "native": "rejects", "mock": "rejects"},
    {"name": "onboarding rejects optimistic string milestone", "patch": {"onboardingDemoSeen": "true"}, "native": "rejects", "mock": "rejects"},
    {"name": "minimum workspace zoom", "patch": {"workspaceZoom": 70}, "native": "accepts", "mock": "accepts"},
    {"name": "maximum workspace zoom", "patch": {"workspaceZoom": 150}, "native": "accepts", "mock": "accepts"},
    {"name": "workspace zoom below minimum", "patch": {"workspaceZoom": 60}, "native": "rejects", "mock": "rejects"},
    {"name": "workspace zoom above maximum", "patch": {"workspaceZoom": 160}, "native": "rejects", "mock": "rejects"},
    {"name": "workspace zoom between steps", "patch": {"workspaceZoom": 115}, "native": "rejects", "mock": "rejects"},
    {"name": "workspace zoom with wrong type", "patch": {"workspaceZoom": "120"}, "native": "rejects", "mock": "rejects"},
